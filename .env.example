# 真实 TypeSafe Jev。默认绝不回退成假答案或规则控制器。
TYPESAFE_API_KEY=
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# Minecraft Java；默认连接自己电脑上的 1.16.5 测试服。
MC_HOST=127.0.0.1
MC_PORT=25565
MC_VERSION=1.16.5
MC_USERNAME=JevStudent
MC_AUTH=offline

# 正版联机认证可改成 microsoft，MC_USERNAME 填用于认证的账号标识。
# 不要填写密码。首次登录使用 Mineflayer/微软的设备授权流程。
# 请勿把 offline 测试服务器暴露到公网。

MAX_STEPS=40
ACTION_TIMEOUT_MS=25000
MIN_HEALTH=8
SCAN_RADIUS=16
ROAM_RADIUS=32

# Pokémon structured live feed (the same TYPESAFE_API_KEY is used by Python).
TYPESAFE_MODEL=jev-latest
LIVE_HOST=127.0.0.1
LIVE_PORT=18766
# POKEMON_PYTHON=/absolute/path/to/venv/bin/python

# Optional FFmpeg binary for continuous H.264 game video.
# POKEMON_FFMPEG=/opt/homebrew/bin/ffmpeg
