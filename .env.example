# Copy to .env locally. Never commit actual keys.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# auto uses DeepSeek when configured; --planner-mode deepseek requires it.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled
# DEEPSEEK_BASE_URL=https://api.deepseek.com

LIVE_HOST=127.0.0.1
LIVE_PORT=18766
# POKEMON_PYTHON=/absolute/path/to/venv/bin/python
# POKEMON_FFMPEG=/opt/homebrew/bin/ffmpeg
