# Python 游戏循环使用的 TypeSafe JEV 配置。
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# 高层规划模型（DeepSeek，OpenAI 兼容接口）；留空时只用确定性本地策略。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 需要更长推理时可启用；名称以实际账户支持的模型为准。
DEEPSEEK_THINKING=disabled
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 实时网页；npm start 同时启动游戏，npm run live 只启动网页。
LIVE_HOST=127.0.0.1
LIVE_PORT=18766

# 默认使用仓库 .venv 中的 Python，找不到时使用 python3。
# POKEMON_PYTHON=/absolute/path/to/venv/bin/python

# 连续 H.264 视频使用的 FFmpeg；默认从 PATH 查找。
# POKEMON_FFMPEG=/opt/homebrew/bin/ffmpeg
